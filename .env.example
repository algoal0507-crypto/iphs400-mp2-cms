# Copy to .env (which is gitignored) and change the values.
# Values with spaces must stay quoted, or `uv run --env-file .env` cannot read the file.
CMS_SECRET_KEY=change-me-to-a-long-random-string
CMS_SITE_TITLE="La Once Mil"
CMS_DATABASE=cms.db
# Demo accounts created by scripts/seed_demo.py
CMS_ADMIN_PASSWORD=change-me-admin
CMS_EDITOR_PASSWORD=change-me-editor
# Set after you deploy, e.g. https://yourname.github.io/iphs400-mp2-cms/
CMS_BASE_PATH=
